# Copy to .env on the server and fill in. .env is git-ignored and must stay that way:
# it holds every secret the stack has.
#   cp .env.example .env && chmod 600 .env

# Public hostnames Caddy answers on, and the certificates it asks Let's Encrypt for.
# The second one only redirects to SITE_URL (see Caddyfile). Use :80 instead to test
# over plain HTTP without a domain.
SITE_ADDRESS="burgometro.com.ar, www.burgometro.com.ar"
# The main host as a full URL. The backend uses it as the allowed CORS origin and in
# the sitemap; Caddy sends www here.
SITE_URL=https://burgometro.com.ar

POSTGRES_DB=hamburguesas
POSTGRES_USER=hamburguesas
# Generate, do not invent: openssl rand -base64 32
POSTGRES_PASSWORD=

# At least 32 characters. Changing it logs everyone out, which is the point if it leaks.
# Generate: openssl rand -base64 48
JWT_SECRET=

# --- Email ---
# Brevo, with burgometro.com.ar authenticated there (see README). Both values come
# from Brevo → SMTP & API → SMTP. Leave SPRING_MAIL_HOST empty and no email is sent
# at all — codes are written to the log instead, which is how local development works.
SPRING_MAIL_HOST=smtp-relay.brevo.com
# The "Login" shown on that page, something like 1a2b3c001@smtp-brevo.com.
SPRING_MAIL_USERNAME=
# An SMTP key generated on that page (not the Brevo account password). Never commit this.
SPRING_MAIL_PASSWORD=
# Any address on the authenticated domain. Nobody reads it: replies bounce.
MAIL_FROM=no-responder@burgometro.com.ar

# Optional: leave empty and the Places sync simply never runs.
GOOGLE_MAPS_API_KEY=
PLACES_SYNC_ENABLED=false
# Shared secret for the manual sync endpoint: openssl rand -hex 32
PLACES_SYNC_TOKEN=

# --- Ingreso con Google ---
# OAuth Client ID (Web application) de Google Cloud Console. Es público: viaja
# dentro del bundle del frontend. Vacío deshabilita el ingreso con Google.
GOOGLE_CLIENT_ID=

# --- Estadísticas de visitas (Umami) ---
# La contraseña del usuario de Umami en Postgres. Solo letras y números, porque va
# adentro de una URL: openssl rand -hex 24
UMAMI_DB_PASSWORD=
# Firma las sesiones del panel de Umami: openssl rand -hex 32
UMAMI_APP_SECRET=
# El id del sitio que se crea en el panel de Umami (ver README). Vacío, la web no
# carga el contador de visitas: el primer deploy va así, y se completa después.
UMAMI_WEBSITE_ID=

# Poné false solo si querés correr sin emails a propósito. En true (el valor por
# defecto en producción) la app no arranca si falta la configuración de SMTP, que es
# preferible a que los códigos terminen escritos en el log.
MAIL_ENABLED=true
