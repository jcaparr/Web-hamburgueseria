# Copy to .env on the server and fill in. .env is git-ignored and must stay that way:
# it holds every secret the stack has.
#   cp .env.example .env && chmod 600 .env

# Public hostname Caddy answers on, and the certificate it asks Let's Encrypt for.
# Use :80 instead to test over plain HTTP without a domain.
SITE_ADDRESS=hamburguesas.duckdns.org
# The same host as a full URL. The backend uses it as the allowed CORS origin.
SITE_URL=https://hamburguesas.duckdns.org

POSTGRES_DB=hamburguesas
POSTGRES_USER=hamburguesas
# Generate, do not invent: openssl rand -base64 32
POSTGRES_PASSWORD=

# At least 32 characters. Changing it logs everyone out, which is the point if it leaks.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Optional: leave empty and the Places sync simply never runs.
GOOGLE_MAPS_API_KEY=
PLACES_SYNC_ENABLED=false
# Shared secret for the manual sync endpoint: openssl rand -hex 32
PLACES_SYNC_TOKEN=
