# Copy to .env on the server and fill in. .env is git-ignored and must stay that way:
# it holds every secret the stack has.
#   cp .env.example .env && chmod 600 .env

# Public hostname Caddy answers on, and the certificate it asks Let's Encrypt for.
# Use :80 instead to test over plain HTTP without a domain.
SITE_ADDRESS=hamburguesas.duckdns.org
# The same host as a full URL. The backend uses it as the allowed CORS origin.
SITE_URL=https://hamburguesas.duckdns.org

POSTGRES_DB=hamburguesas
POSTGRES_USER=hamburguesas
# Generate, do not invent: openssl rand -base64 32
POSTGRES_PASSWORD=

# At least 32 characters. Changing it logs everyone out, which is the point if it leaks.
# Generate: openssl rand -base64 48
JWT_SECRET=

# --- Email ---
# Gmail account dedicated to the app, with 2-step verification on and an app
# password generated at https://myaccount.google.com/apppasswords
# It must be an app password: Gmail rejects the account password over SMTP.
# Leave SPRING_MAIL_HOST empty and no email is sent at all — codes are written to
# the log instead, which is how local development works.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_USERNAME=burgerpages@gmail.com
# The 16-character app password, no spaces. Never commit this.
SPRING_MAIL_PASSWORD=
# Has to match SPRING_MAIL_USERNAME: Gmail refuses a From it did not authenticate.
MAIL_FROM=burgerpages@gmail.com

# Optional: leave empty and the Places sync simply never runs.
GOOGLE_MAPS_API_KEY=
PLACES_SYNC_ENABLED=false
# Shared secret for the manual sync endpoint: openssl rand -hex 32
PLACES_SYNC_TOKEN=

# --- Ingreso con Google ---
# OAuth Client ID (Web application) de Google Cloud Console. Es público: viaja
# dentro del bundle del frontend. Vacío deshabilita el ingreso con Google.
GOOGLE_CLIENT_ID=
