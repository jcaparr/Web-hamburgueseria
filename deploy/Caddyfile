# El log general, que es donde va cada error (un 502 si el backend no contesta, por
# ejemplo) con el pedido que lo causó. Lleva el mismo filtro que el log de pedidos de
# abajo: sin él, la ubicación de "Cerca mío" quedaba escrita cada vez que algo fallaba.
{
	log default {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					delete latitud
					delete longitud
				}
			}
		}
	}
}

# SITE_ADDRESS is the public hostname (for example hamburguesas.duckdns.org).
# Caddy gets and renews the Let's Encrypt certificate for it on its own.
# Set it to :80 to serve plain HTTP when testing locally.
{$SITE_ADDRESS} {
	encode zstd gzip

	# The API and the site share an origin, so the session cookie needs no CORS exception.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# El mapa del sitio lo arma el backend, porque cambia con los locales. Va en la raíz
	# porque es donde lo anuncia robots.txt.
	handle /sitemap.xml {
		rewrite * /api/sitemap.xml
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		# Hashed asset filenames change on every build, so they can be cached forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Todo lo demás —el index.html sobre todo— se vuelve a confirmar en cada visita.
		# Sin esto el navegador podía quedarse con el index.html de antes de un deploy,
		# que pide archivos de /assets que ya no existen, y la página quedaba en blanco.
		@resto not path /assets/*
		header @resto Cache-Control "no-cache"
		# Client-side routing: unknown paths are React Router's problem, not a 404.
		try_files {path} /index.html
		file_server
	}

	header {
		# Caddy serves HTTPS on its own; this tells browsers never to try plain HTTP.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server

		# The session cookies are out of reach of JavaScript, so an injected script
		# cannot steal them. This is the other half: making it hard to get a script
		# in at all, and limiting where one could send anything it did read.
		#
		# Todo sale de acá salvo el botón de Google, que carga su script, se dibuja
		# en un iframe y le habla a Google. Ese es el único tercero que queda, y solo
		# entra en juego cuando alguien va a iniciar sesión: quien únicamente mira
		# hamburgueserías no toca ningún servidor ajeno.
		#
		# Las tipografías se sirven desde acá, así que no hay nada de Google en
		# style-src ni en font-src. Mientras estuvieron los dominios de Google, cada
		# visitante le dejaba su IP en cada visita.
		# blob: en img-src es la foto que se elige al reseñar: la vista previa y la
		# medición de su tamaño la cargan desde una URL que crea el propio navegador.
		# Sin eso no se veía y una foto chica pasaba sin aviso (#137). Una URL blob:
		# solo la puede crear un script de este origen.
		#
		# En una sola línea a propósito: un valor de header no puede contener saltos
		# de línea, y partido en varias Caddy lo descarta en silencio.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; frame-src https://accounts.google.com/gsi/; connect-src 'self' https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self'; img-src 'self' data: blob: https://lh3.googleusercontent.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

		# Nada de esto usa cámara, micrófono ni pagos, así que no están disponibles ni
		# para un script que logre entrar. La ubicación sí: la pantalla de tour la pide
		# para armar el recorrido desde donde está quien lo pide. Con los paréntesis
		# vacíos quedaba apagada para todos los orígenes, el nuestro incluido, y "Cerca
		# mío" no iba a conseguir ubicación nunca en producción.
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
	}

	# Cada pedido queda anotado, con su IP, para investigar abusos y fallas. Las cookies
	# no: Caddy las tacha solo. La ubicación tampoco: "Cerca mío" la manda en la
	# dirección del pedido (latitud y longitud), y sin este filtro quedaba escrito en el
	# log dónde estaba cada persona que armó un recorrido. La política de privacidad dice
	# que la ubicación no se guarda.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					delete latitud
					delete longitud
				}
			}
		}
	}
}
