# Backend (Maven / Java)
backend/target/
*.class
*.log
backend/data/

# Frontend (Node)
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Env / secrets
.env
*.env
!deploy/.env.example

# Backups: contienen los emails de todos los usuarios
deploy/backups/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Herramientas locales / clones sueltos
.claude/
/auth/
tools/
/.vite/

# Cualquier copia del .env: respaldos, .env.bak, .env.viejo. Las reglas de arriba
# solo atrapan los que terminan en .env, así que un deploy/.env.bak-123 quedaba
# afuera y podía subirse con las claves adentro.
.env.*
!.env.example
